{
  "expo": {
    "name": "PlusNet Kasir",
    "slug": "plusnet-kasir-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4fcf2"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.plusnet.kasir",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4fcf2"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plusnet.kasir"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan akses kamera untuk memindai barcode produk."
        }
      ],
      "expo-audio",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3cca4986-8967-4cf8-bc5f-ca67c18d6de0"
      }
    }
  }
}
